{
  "name": "clippy-foundation",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": "22.23.4", "npm": "11.8.0" },
  "packageManager": "npm@11.8.0",
  "workspaces": ["services/backend", "services/processing", "infra"],
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint services infra tools --ext .ts",
    "format:check": "prettier --check 'services/**/*.ts' 'infra/**/*.ts' 'tools/*.ts'",
    "format": "prettier --write 'services/**/*.ts' 'infra/**/*.ts' 'tools/*.ts'",
    "check:contracts": "tsx tools/check-contracts.ts",
    "test": "tsx --test services/backend/test/*.test.ts",
    "synth": "tsx infra/src/app.ts",
    "check": "bash tools/check.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "aws-cdk": "2.1148.0",
    "eslint": "10.14.0",
    "eslint-plugin-awscdk": "4.4.4",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
