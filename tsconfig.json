{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true, "noEmit": true
  },
  "include": ["services/**/*.ts", "infra/**/*.ts", "tools/**/*.ts"]
}
